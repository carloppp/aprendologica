{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pwa-dist",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8091",
        "--directory",
        "caza-estelar/web/build/dist/js/webapp"
      ],
      "port": 8091
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "caza-estelar/app",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "caza-estelar/app",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
