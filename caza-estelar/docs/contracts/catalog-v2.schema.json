{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://explorax.app/contracts/catalog-v2.schema.json",
  "title": "Caza Estelar - catálogo de contenido v2",
  "description": "Planteamiento septiembre 2026. Ver docs/CONTENT_SCHEMA_V2.md. Aún no implementado en el parser.",
  "type": "object",
  "required": [
    "schemaVersion",
    "publishedVersion",
    "revision",
    "minimumAppVersion",
    "constellations"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "publishedVersion": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "minimumAppVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "default": []
    },
    "constellations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constellation"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": [
        "es",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "type",
        "mimeType",
        "url",
        "sha256",
        "sizeBytes",
        "required"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "image",
            "audio"
          ]
        },
        "mimeType": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "constellation": {
      "type": "object",
      "required": [
        "id",
        "version",
        "order",
        "area",
        "title",
        "description",
        "levels"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coverAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level"
          }
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "id",
        "version",
        "order",
        "title",
        "instruction",
        "mechanic",
        "completion"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "instruction": {
          "$ref": "#/$defs/localizedText"
        },
        "mechanic": {
          "$ref": "#/$defs/mechanic"
        },
        "unlock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prerequisiteLevelIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "default": []
            }
          }
        },
        "completion": {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "minimum_score"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "experience": {
              "type": "integer",
              "minimum": 0
            },
            "badgeId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "promptAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "narrationAssetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "backgroundAssetId": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "mechanic": {
      "type": "object",
      "required": [
        "type",
        "schemaVersion",
        "config"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "telescope_hunt"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "targetCount",
                  "lockRadius"
                ],
                "additionalProperties": false,
                "properties": {
                  "targetCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "lockRadius": {
                    "type": "number",
                    "minimum": 40,
                    "maximum": 180
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "question",
                  "options",
                  "attempts",
                  "successFeedback",
                  "retryFeedback"
                ],
                "additionalProperties": false,
                "properties": {
                  "question": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "text",
                        "correct"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "$ref": "#/$defs/localizedText"
                        },
                        "correct": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_select"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "prompt",
                        "pieces",
                        "target"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "prompt": {
                          "$ref": "#/$defs/localizedText"
                        },
                        "pieces": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 8,
                          "items": {
                            "$ref": "#/$defs/piece"
                          }
                        },
                        "target": {
                          "$ref": "#/$defs/pieceFilter"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_membership"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "set",
                        "candidate"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "set": {
                          "$ref": "#/$defs/pieceSet"
                        },
                        "candidate": {
                          "$ref": "#/$defs/piece"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_subset"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "set",
                        "groups"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "set": {
                          "$ref": "#/$defs/pieceSet"
                        },
                        "groups": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 3,
                          "items": {
                            "$ref": "#/$defs/pieceSet"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_intersection"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "a",
                        "b",
                        "pieces"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "a": {
                          "$ref": "#/$defs/pieceFilter"
                        },
                        "b": {
                          "$ref": "#/$defs/pieceFilter"
                        },
                        "pieces": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 7,
                          "items": {
                            "$ref": "#/$defs/piece"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_union"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "a",
                        "b"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "a": {
                          "$ref": "#/$defs/pieceSet"
                        },
                        "b": {
                          "$ref": "#/$defs/pieceSet"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_difference"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "type": "object",
                "required": [
                  "attempts",
                  "successFeedback",
                  "retryFeedback",
                  "rounds"
                ],
                "additionalProperties": false,
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  },
                  "successFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "retryFeedback": {
                    "$ref": "#/$defs/localizedText"
                  },
                  "rounds": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "a",
                        "b"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "a": {
                          "$ref": "#/$defs/pieceSet"
                        },
                        "b": {
                          "$ref": "#/$defs/pieceSet"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "piece": {
      "type": "object",
      "required": [
        "shape",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "star",
            "moon",
            "gem",
            "circle"
          ]
        },
        "color": {
          "enum": [
            "yellow",
            "cyan",
            "purple",
            "blue",
            "pink"
          ]
        }
      }
    },
    "pieceFilter": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "shape": {
          "enum": [
            "star",
            "moon",
            "gem",
            "circle"
          ]
        },
        "color": {
          "enum": [
            "yellow",
            "cyan",
            "purple",
            "blue",
            "pink"
          ]
        }
      }
    },
    "pieceSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/piece"
      }
    }
  }
}
